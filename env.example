NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
REGISTRATION_IP_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PROXYCHECK_API_KEY=YOUR_PROXYCHECK_IO_API_KEY

# Manual GCash checkout
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/kvPZ95ZsVk
NEXT_PUBLIC_GCASH_ACCOUNT_NAME=
NEXT_PUBLIC_GCASH_NUMBER=
NEXT_PUBLIC_GCASH_QR_URL=

# PayPal automatic checkout. PAYPAL_CLIENT_SECRET must remain server-only.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=YOUR_PAYPAL_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_LIVE_CLIENT_SECRET
PAYPAL_ENVIRONMENT=live
